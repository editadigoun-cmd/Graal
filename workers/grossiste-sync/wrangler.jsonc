{
  "name": "provisit-grossiste-sync",
  "main": "index.mjs",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "browser": {
    "binding": "BROWSER"
  },
  "triggers": {
    "crons": [
      "0 5 * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true },
    "traces": { "enabled": true, "head_sampling_rate": 1, "persist": true },
    "issues": { "enabled": true }
  },
  "vars": {
    "SUPABASE_URL": "https://bjwcsfdvucrwtlheivuu.supabase.co"
  }
}
